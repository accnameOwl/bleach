macro "macro"
	elem 
		name = "Any"
		command = "KeyStatus [[*]] 1"
	elem 
		name = "Any+UP"
		command = "KeyStatus [[*]] 0"


menu "menu"
	elem 
		name = "&File"
		command = ""
		saved-params = "is-checked"
	elem 
		name = "&Quit"
		command = ".quit"
		category = "&File"
		saved-params = "is-checked"
	elem "view"
		name = "View"
		command = ""
		saved-params = "is-checked"
	elem 
		name = "Commands"
		command = "ShowCommandWindow"
		category = "View"
		saved-params = "is-checked"
	elem 
		name = "PrettyDebug"
		command = "ShowDebugWindow"
		category = "Admin"
		saved-params = "is-checked"
	elem 
		name = "Start Profiler"
		command = "StartProfiler"
		category = "Admin"
		saved-params = "is-checked"
	elem 
		name = "Stop Profiler"
		command = "StopProfiler"
		category = "Admin"
		saved-params = "is-checked"


window "characterWindow"
	elem "characterWindow"
		type = MAIN
		pos = 384,0
		size = 330x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-transparent = true
		saved-params = "pos;size;is-minimized;is-maximized"
		titlebar = false
		statusbar = false
		can-close = false
		can-minimize = false
		can-resize = false
		is-pane = true
	elem "browser"
		type = BROWSER
		pos = 0,0
		size = 330x480
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = ""

